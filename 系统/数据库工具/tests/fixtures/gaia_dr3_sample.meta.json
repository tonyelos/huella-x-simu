  "query_template": "SELECT g.source_id,\n       g.ra,\n       g.dec,\n       g.pmra,\n       g.pmdec,\n       g.parallax,\n       g.ra_error,\n       g.dec_error,\n       g.pmra_error,\n       g.pmdec_error,\n       g.parallax_error,\n       g.ruwe,\n       g.astrometric_excess_noise,\n       g.phot_variable_flag,\n       g.phot_g_mean_mag,\n       g.bp_rp,\n       g.ref_epoch,\n       g.in_qso_candidates,\n       g.in_galaxy_candidates,\n       g.non_single_star,\n       t.original_ext_source_id AS twomass_id,\n       w.original_ext_source_id AS wise_id\nFROM gaiadr3.gaia_source AS g\nLEFT JOIN gaiadr3.tmass_psc_xsc_best_neighbour AS t ON t.source_id = g.source_id\nLEFT JOIN gaiadr3.allwise_best_neighbour AS w ON w.source_id = g.source_id\nWHERE CONTAINS(POINT('ICRS', g.ra, g.dec), CIRCLE('ICRS', 0.00000000, 0.00000000, 0.25)) = 1\n  AND g.phot_g_mean_mag <= 20",
